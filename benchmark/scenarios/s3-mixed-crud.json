{
  "id": "s3-mixed-crud",
  "name": "S3 Mixed CRUD",
  "description": "Mixed CRUD workload on a medium data state: keyset-paginated and single-resource reads plus create and update writes. All reads are bounded so results reflect framework request handling rather than full-table serialization.",
  "operations": [
    {
      "name": "listTodosPaged",
      "method": "GET",
      "path": "/todos?limit=100&afterId={{afterId}}",
      "weight": 55
    },
    {
      "name": "getTodoById",
      "method": "GET",
      "path": "/todos/:id",
      "weight": 15
    },
    {
      "name": "createTodo",
      "method": "POST",
      "path": "/todos",
      "weight": 15,
      "bodyTemplate": {
        "title": "{{title}}",
        "completed": false,
        "order": "{{order}}"
      }
    },
    {
      "name": "patchTodo",
      "method": "PATCH",
      "path": "/todos/:id",
      "weight": 15,
      "bodyTemplate": {
        "title": "{{title}}",
        "completed": "{{completed}}",
        "order": "{{order}}"
      }
    }
  ]
}
